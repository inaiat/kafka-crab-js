{
  "name": "pdf-crab-js",
  "version": "1.0.0",
  "keywords": [
    "N-API",
    "Rust",
    "napi",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "pdf"
  ],
  "homepage": "https://github.com/flash-tecnologia/crab-js",
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-tecnologia/crab-js.git",
    "directory": "packages/pdf-crab-js"
  },
  "files": [
    "dist",
    "browser.js",
    "browser-threaded.js",
    "browser.d.ts",
    "js-binding.js",
    "js-binding.cjs",
    "js-binding.d.ts",
    "MIGRATION.md",
    "*.wasi-browser.js",
    "*.wasi.cjs",
    "*.wasi.d.cts",
    "*.wasip1-browser.js",
    "*.wasip1.cjs",
    "*.wasip1.d.cts",
    "pdf-crab-js.wasm32-wasi.wasm",
    "pdf-crab-js.wasm32-wasip1.wasm",
    "wasi-worker*.mjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "browser": "./browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "import": "./browser.js",
      "default": "./browser.js"
    },
    "./browser.js": {
      "types": "./browser.d.ts",
      "import": "./browser.js",
      "default": "./browser.js"
    },
    "./browser/threaded": {
      "types": "./browser.d.ts",
      "import": "./browser-threaded.js",
      "default": "./browser-threaded.js"
    },
    "./wasm": {
      "types": "./browser.d.ts",
      "import": "./browser.js",
      "default": "./browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "check": "vp check",
    "build": "node build.mjs",
    "build:js": "node build.mjs --js-only",
    "build:debug": "node build.mjs --debug",
    "build:wasm": "node build.mjs --target wasm32-wasip1",
    "build:wasm-threaded": "node build.mjs --target wasm32-wasip1-threads",
    "example": "pnpm --dir ../.. --filter pdf-crab-js-examples example",
    "example:table": "pnpm --dir ../.. --filter pdf-crab-js-examples example:table",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepack": "node build.mjs --js-only",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "pnpm run build && vp test run js-tests/unit",
    "test:wasm": "pnpm run build:wasm && NAPI_RS_FORCE_WASI=error node js-tests/wasm-smoke.mjs",
    "test:wasm-threaded": "pnpm run build:wasm-threaded && NAPI_RS_FORCE_WASI=error PDF_CRAB_WASM_THREADED=1 node js-tests/wasm-smoke.mjs",
    "test:unit": "vp test run js-tests/unit"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@emnapi/core": "catalog:",
    "@emnapi/runtime": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@napi-rs/wasm-runtime": "catalog:"
  },
  "napi": {
    "binaryName": "pdf-crab-js",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
